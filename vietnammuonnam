-- TAB 1: AUTO FARM
local FarmTab = Window:NewTab("Auto Farm")
local FarmSection = FarmTab:NewSection("Tự Động Câu Cá")

_G.AutoCast = false
_G.AutoReel = false

FarmSection:NewToggle("Auto Cast (Quăng Cần)", "Tự động thả cần câu", function(state)
    _G.AutoCast = state
end)

FarmSection:NewToggle("Auto Reel (Giật Cá)", "Tự động kéo cá hoàn hảo", function(state)
    _G.AutoReel = state
end)

task.spawn(function()
    while task.wait(0.2) do
        pcall(function()
            if _G.AutoCast then
                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    for _, v in pairs(tool:GetDescendants()) do
                        if v:IsA("RemoteEvent") then v:FireServer() end
                    end
                end
            end
            if _G.AutoReel then
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("reel") or v.Name:lower():find("catch")) then
                        v:FireServer(100, true)
                    end
                end
            end
        end)
    end
end)

-- TAB 2: NHIỆM VỤ
local QuestTab = Window:NewTab("Nhiệm Vụ")
local QuestSection = QuestTab:NewSection("Auto Quest")

_G.AutoQuest = false

QuestSection:NewToggle("Auto Quest (Nhận & Trả Nhiệm Vụ)", "Tự động làm nhiệm vụ NPC", function(state)
    _G.AutoQuest = state
end)

task.spawn(function()
    while task.wait(1) do
        if _G.AutoQuest then
            pcall(function()
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                        local n = v.Name:lower()
                        if n:find("quest") or n:find("task") or n:find("nhiemvu") then
                            if v:IsA("RemoteEvent") then
                                v:FireServer("Accept")
                                v:FireServer("Claim")
                                v:FireServer("Complete")
                            end
                        end
                    end
                end
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                end
            end)
        end
    end
end)

-- TAB 3: DỊCH CHUYỂN ĐẢO
local TeleportTab = Window:NewTab("Dịch Chuyển Đảo")
local TeleportSection = TeleportTab:NewSection("Các Đảo Trong Game")

local Islands = {
    ["Đảo Khởi Đầu"] = Vector3.new(0, 15, 0),
    ["Đảo Làng Chài"] = Vector3.new(150, 20, -300),
    ["Đảo Tuyết"] = Vector3.new(-800, 25, 500),
    ["Đảo Núi Lửa"] = Vector3.new(1200, 30, -900),
    ["Đảo Bầu Trời"] = Vector3.new(0, 500, 0),
    ["Đảo Cổ Đại"] = Vector3.new(-1500, 20, -1200)
}

local SelectedPos = Islands["Đảo Khởi Đầu"]

TeleportSection:NewDropdown("Chọn Đảo", "Chọn đảo muốn tới", {"Đảo Khởi Đầu", "Đảo Làng Chài", "Đảo Tuyết", "Đảo Núi Lửa", "Đảo Bầu Trời", "Đảo Cổ Đại"}, function(option)
    if Islands[option] then SelectedPos = Islands[option] end
end)

TeleportSection:NewButton("Dịch Chuyển Đến Đảo", "Tới vị trí đảo đã chọn", function()
    pcall(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(SelectedPos) end
    end)
end)

-- TAB 4: BÁN CÁ
local SellTab = Window:NewTab("Bán Cá")
local SellSection = SellTab:NewSection("Auto Sell")

SellSection:NewButton("Bán Toàn Bộ Cá Ngay", "Bán nhanh tất cả cá", function()
