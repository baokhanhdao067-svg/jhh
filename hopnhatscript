---------------------------------------------------------
local function forceCollectEgg(eggObject)
    if not eggObject then return end

    -- Kích hoạt ProximityPrompt
    for _, prompt in pairs(eggObject:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.01)
                prompt:InputHoldEnd()
            end
        end
    end

    -- Kích hoạt ClickDetector
    for _, clicker in pairs(eggObject:GetDescendants()) do
        if clicker:IsA("ClickDetector") and fireclickdetector then
            fireclickdetector(clicker)
        end
    end

    -- Quét & Trigger RemoteEvent (Mới Update)
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
            local rName = obj.Name:lower()
            if rName:find("steal") or rName:find("egg") or rName:find("pick") or rName:find("grab") or rName:find("collect") or rName:find("claim") then
                pcall(function()
                    obj:FireServer(eggObject)
                end)
            end
        end
    end
end

