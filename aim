local isDragging = false
local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    Settings.AimHeadRate = math.floor(pos * 200)
    SliderLabel.Text = "Tỷ Lệ Tối Đa Vào Đầu: " .. Settings.AimHeadRate .. "%"
end

SliderFrame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        isDragging = true; UpdateSlider(inp)
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)
UserInputService.InputChanged:Connect(function(inp)
    if isDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(inp)
    end
end)

-- [[ 3. THUẬT TOÁN TÌM MỤC TIÊU Ở KHOẢNG CÁCH GẦN NHẤT ]] --
local function GetNearestTarget()
    local nearestHead = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if not myHrp then return nil end

    -- Quét Người Chơi Gần Nhất
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") then
            if plr.Character.Humanoid.Health > 0 then
                local head = plr.Character.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (head.Position - myHrp.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearestHead = head
                    end
                end
            end
        end
    end

    -- Quét NPC / Con Rối Gần Nhất
    if Settings.TargetPuppets then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= myChar and obj:FindFirstChild("Head") and obj:FindFirstChild("Humanoid") then
                if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                    local head = obj.Head
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (head.Position - myHrp.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            nearestHead = head
                        end
                    end
                end
            end
        end
    end

    return nearestHead
end

-- [[ 4. HỆ THỐNG ESP BẢN ĐỒ ]] --
local EspHolders = {}
local function DrawEsp(model, name, health, maxHealth, isPlayer)
    if not EspHolders[model] then
        local box = Drawing.new("Square")
        box.Color = isPlayer and Color3.fromRGB(255, 30, 90) or Color3.fromRGB(255, 180, 0)
        box.Thickness = 1.5; box.Filled = false; box.Visible = false

        local healthBar = Drawing.new("Square")
        healthBar.Thickness = 1.5; healthBar.Filled = true; healthBar.Visible = false

        local tracer = Drawing.new("Line")
        tracer.Color = Color3.fromRGB(255, 30, 90); tracer.Thickness = 1.2; tracer.Visible = false

        local text = Drawing.new("Text")
        text.Color = Color3.fromRGB(255, 255, 255)
        text.Size = 12; text.Center = true; text.Outline = true; text.Visible = false

        EspHolders[model] = {Box = box, Health = healthBar, Tracer = tracer, Text = text}
    end

    local esp = EspHolders[model]
    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart
    if hrp and model:FindFirstChild("Head") then
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local headPos = Camera:WorldToViewportPoint(model.Head.Position + Vector3.new(0, 0.5, 0))
            local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            local height = math.abs(headPos.Y - legPos.Y)
            local width = height / 1.8

            esp.Box.Size = Vector2.new(width, height)
            esp.Box.Position = Vector2.new(screenPos.X - width / 2, screenPos.Y - height / 2)
            esp.Box.Visible = true

            local healthPct = math.clamp(health / maxHealth, 0, 1)
            esp.Health.Size = Vector2.new(2, height * healthPct)
            esp.Health.Position = Vector2.new((screenPos.X - width / 2) - 5, (screenPos.Y + height / 2) - (height * healthPct))
            esp.Health.Color = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
            esp.Health.Visible = true

            if Settings.EspTracer then
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                esp.Tracer.Visible = true
            else
                esp.Tracer.Visible = false
            end

            esp.Text.Text = string.format("%s [%d/%d]", name, math.floor(health), math.floor(maxHealth))
            esp.Text.Position = Vector2.new(screenPos.X, screenPos.Y - (height / 2) - 14)
            esp.Text.Visible = true
        else
            esp.Box.Visible = false; esp.Health.Visible = false; esp.Tracer.Visible = false; esp.Text.Visible = false
        end
    end
end

-- [[ 5. ENGINE V8 HYPERION RENDER STEPPED (ULTRA LOCK 200%) ]] --
RunService.RenderStepped:Connect(function()
    FovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- AIMBOT GHIM TÍCH HỢP LOCK CỨNG 200% OVERDRIVE
    if Settings.AimbotEnabled then
        local targetHead = GetNearestTarget()
        if targetHead then
            local chance = math.random(1, 100)
            -- Tăng tỷ lệ dán đạn tối đa 200%
            if chance <= math.clamp(Settings.AimHeadRate, 1, 100) or Settings.AimHeadRate > 100 then
                local targetPos = targetHead.Position
                if Settings.Prediction and targetHead.Parent:FindFirstChild("HumanoidRootPart") then
                    targetPos = targetPos + (targetHead.Parent.HumanoidRootPart.Velocity * Settings.PredictSpeed)
                end

                -- Mở rộng kích thước Hitbox Đầu
                if Settings.SilentHitbox then
                    targetHead.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                    targetHead.Transparency = 0.5
                    targetHead.CanCollide = false
                end

                -- Ghim Siêu Cứng 100% CFrame
                if Settings.UltraHardLock then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                else
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 0.45)
                end
            end
        end
    end

    -- ĐỊNH VỊ ESP
    if Settings.EspEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") then
                if plr.Character.Humanoid.Health > 0 then
                    DrawEsp(plr.Character, plr.Name, plr.Character.Humanoid.Health, plr.Character.Humanoid.MaxHealth, true)
                end
            end
        end
        if Settings.TargetPuppets then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= LocalPlayer.Character and obj:FindFirstChild("Head") and obj:FindFirstChild("Humanoid") then
                    if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                        DrawEsp(obj, obj.Name, obj.Humanoid.Health, obj.Humanoid.MaxHealth, false)
                    end
                end
            end
        end
    else
        for _, esp in pairs(EspHolders) do
            esp.Box.Visible = false
            esp.Health.Visible = false
            esp.Tracer.Visible = false
            esp.Text.Visible = false
        end
    end
end)
