-- 4. LOGIC CHỐNG QUÁI ĐÁNH & GIỮ TỐC ĐỘ BÌNH THƯỜNG
---------------------------------------------------------
local isAntiHit = false
local antiHitConn = nil

antiHitBtn.MouseButton1Click:Connect(function()
    isAntiHit = not isAntiHit
    antiHitBtn.BackgroundColor3 = isAntiHit and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    antiHitBtn.Text = "Chống Quái Đánh & Lag Speed: " .. (isAntiHit and "BẬT" or "TẮT")

    if isAntiHit then
        antiHitConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
                end
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if antiHitConn then antiHitConn:Disconnect(); antiHitConn = nil end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CanCollide = true
        end
    end
end)

---------------------------------------------------------
-- 5. LOGIC TỰ ĐỘNG BAY KHI LỤM TRỨNG (MỚI TRIỆT ĐỂ)
---------------------------------------------------------
local isAutoFly = false
local isFlying = false
local bodyVel = nil

local function flyUp()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if not bodyVel or not bodyVel.Parent then
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bodyVel.Velocity = Vector3.new(0, 45, 0) -- Tốc độ bay lên trời
        bodyVel.Parent = char.HumanoidRootPart
    end
    isFlying = true
    statusLabel.Text = "Đang Bay Cực Cao (Đã Nhặt Trứng)!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

local function stopFly()
    if bodyVel then
        bodyVel:Destroy()
        bodyVel = nil
    end
    isFlying = false
    statusLabel.Text = "Trạng thái: Chưa có trứng"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

-- Nhận diện vật phẩm Trứng chính xác trong Steal an Egg
local function checkHasEgg()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    -- Lặp qua tất cả vật phẩm đang cầm hoặc trong kho
    local items = {}
    if char then
        for _, v in pairs(char:GetChildren()) do table.insert(items, v) end
    end
    if backpack then
        for _, v in pairs(backpack:GetChildren()) do table.insert(items, v) end
    end

    for _, item in pairs(items) do
        if item:IsA("Tool") or item:IsA("Model") then
            local n = item.Name:lower()
            if n:find("egg") or n:find("trung") or item:FindFirstChild("Egg") or item:FindFirstChild("Handle") then
                return true
            end
        end
    end
    return false
end

autoFlyBtn.MouseButton1Click:Connect(function()
    isAutoFly = not isAutoFly
    autoFlyBtn.BackgroundColor3 = isAutoFly and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    autoFlyBtn.Text = "Tự Bay Lên Khi Lụm Trứng: " .. (isAutoFly and "BẬT" or "TẮT")
    
    if not isAutoFly then
        stopFly()
    end
end)

-- Vòng lặp liên tục quét trạng thái nhặt trứng
RunService.Heartbeat:Connect(function()
    if isAutoFly then
        local hasEgg = checkHasEgg()
        if hasEgg and not isFlying then
            flyUp()
        elseif not hasEgg and isFlying then
            stopFly()
        end
    end
end)
