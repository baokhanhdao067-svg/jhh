-- 4. QUÉT VÀ KIỂM TRA MANG TRỨNG
---------------------------------------------------------
local function isCarryingEggSpecial()
    local char = LocalPlayer.Character
    if not char then return false end
    
    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then
            return true
        end
    end
    
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Tool") then
            if part:FindFirstChildOfClass("Weld") or part:FindFirstChildOfClass("WeldConstraint") then
                if part.Name ~= "HumanoidRootPart" and not part.Name:find("Head") and not part.Name:find("Arm") and not part.Name:find("Leg") and not part.Name:find("Torso") then
                    return true
                end
            end
        end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then
        return true
    end

    return false
end

---------------------------------------------------------
-- 5. LOGIC TWEEN BAY VỀ TỌA ĐỘ GROUND
---------------------------------------------------------
local isAutoFly = false
local currentTween = nil
local isTweening = false

local function stopTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    isTweening = false
end

local function tweenToGroundZone()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    isTweening = true
    statusLabel.Text = "🚀 PHÁT HIỆN TRỨNG -> ĐANG BAY VỀ GROUND..."
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)

    -- Lấy tốc độ bay từ ô nhập Speed Box
    local tweenSpeed = tonumber(speedBox.Text) or 300

    -- BƯỚC 1: Bay thẳng lên cao (35 stud) để tránh vật cản địa hình
    local startSkyPos = Vector3.new(hrp.Position.X, hrp.Position.Y + 35, hrp.Position.Z)
    local distUp = (startSkyPos - hrp.Position).Magnitude
    local timeUp = math.max(distUp / tweenSpeed, 0.15)

    local tweenInfoUp = TweenInfo.new(timeUp, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfoUp, {CFrame = CFrame.new(startSkyPos)})
    currentTween:Play()
    currentTween.Completed:Wait()

    if not isAutoFly or not isCarryingEggSpecial() then stopTween() return end

    -- BƯỚC 2: Bay đường thẳng trên không tới vị trí trên đỉnh của Ground Zone
    local targetSkyPos = Vector3.new(SAFE_ZONE_POS.X, SAFE_ZONE_POS.Y + 35, SAFE_ZONE_POS.Z)
    local distFlat = (targetSkyPos - startSkyPos).Magnitude
    local timeFlat = math.max(distFlat / tweenSpeed, 0.3)

    local tweenInfoFlat = TweenInfo.new(timeFlat, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfoFlat, {CFrame = CFrame.new(targetSkyPos)})
    currentTween:Play()
    currentTween.Completed:Wait()

    if not isAutoFly or not isCarryingEggSpecial() then stopTween() return end

    -- BƯỚC 3: Hạ cánh thẳng xuống tọa độ Ground Zone
    statusLabel.Text = "🪂 ĐÃ TỚI GROUND -> ĐANG HẠ CÁNH THẢ TRỨNG..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)

    local dropPos = Vector3.new(SAFE_ZONE_POS.X, SAFE_ZONE_POS.Y + 3, SAFE_ZONE_POS.Z)
    local distDown = (dropPos - targetSkyPos).Magnitude
    local timeDown = math.max(distDown / 120, 0.2)

    local tweenInfoDown = TweenInfo.new(timeDown, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfoDown, {CFrame = CFrame.new(dropPos)})
    currentTween:Play()
    currentTween.Completed:Wait()

    stopTween()
    statusLabel.Text = "Trạng thái: Đã thả trứng an toàn tại Ground!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

