-- Danh sách 7 Script theo thứ tự
local scriptsList = {
    {name = "1. Oroboros Hub No Key", url = "https://raw.githubusercontent.com/joustingmatch/Ouroboros/main/loader.lua"},
    {name = "2. Lynx Hub No Key", url = "https://raw.githubusercontent.com/Habibihidayat42/Lynxx/refs/heads/main/LynxHub.lua"},
    {name = "3. Speed Hub No Key", url = "https://raw.githubusercontent.com/Habibihidayat42/Lynxx/refs/heads/main/LynxHub.lua"},
    {name = "4. Chloe-X No Key", url = "https://raw.githubusercontent.com/MajestySkie/Chloe-X/main/Main/ChloeX"},
    {name = "5. Solvex Hub No Key", url = "https://raw.githubusercontent.com/Solvexxxx/Scripts/refs/heads/main/SolvexGUI_FishIt.lua"},
    {name = "6. Redz Hub No Key", url = "https://raw.githubusercontent.com/REDZ-HUB/FishingMaster/main/NoKey.lua"},
    {name = "7. Shadow Hub No Key", url = "https://raw.githubusercontent.com/ShadowScript/FishingMaster/main/Main.lua"}
}

-- Hàm tạo các dòng Script + Nút kích hoạt
for index, item in ipairs(scriptsList) do
    local ItemFrame = Instance.new("Frame")
    local Label = Instance.new("TextLabel")
    local RunBtn = Instance.new("TextButton")

    ItemFrame.Name = "ItemFrame_" .. index
    ItemFrame.Parent = ScrollFrame
    ItemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    ItemFrame.Size = UDim2.new(1, -10, 0, 40)

    Label.Name = "Label"
    Label.Parent = ItemFrame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(0.65, 0, 1, 0)
    Label.Font = Enum.Font.SourceSans
    Label.Text = item.name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 13.00
    Label.TextXAlignment = Enum.TextXAlignment.Left

    RunBtn.Name = "RunBtn"
    RunBtn.Parent = ItemFrame
    RunBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
    RunBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
    RunBtn.Size = UDim2.new(0.28, 0, 0.7, 0)
    RunBtn.Font = Enum.Font.SourceSansBold
    RunBtn.Text = "Kích Hoạt"
    RunBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    RunBtn.TextSize = 13.00

    -- Xử lý sự kiện bấm nút kích hoạt
    RunBtn.MouseButton1Click:Connect(function()
        RunBtn.Text = "Đang tải..."
        RunBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
        
        task.spawn(function()
            local success, err = pcall(function()
                loadstring(game:HttpGet(item.url))()
            end)
            
            if success then
                RunBtn.Text = "Đã Bật"
                RunBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            else
                RunBtn.Text = "Thất Bại"
                RunBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                warn("Lỗi tải script: " .. tostring(err))
            end
        end)
    end)
end

-- Chức năng bật/tắt ẩn hiện khung Menu
ToggleMenuBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)
