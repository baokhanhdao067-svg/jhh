-- 4. NHẬN DIỆN MANG TRỨNG DÀNH RIÊNG STEAL AN EGG
---------------------------------------------------------
local function isCarryingEggSpecial()
    local char = LocalPlayer.Character
    if not char then return false end
    
    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then
            return true
        end
    end
    
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Tool") then
            if part:FindFirstChildOfClass("Weld") or part:FindFirstChildOfClass("WeldConstraint") then
                if part.Name ~= "HumanoidRootPart" and not part.Name:find("Head") and not part.Name:find("Arm") and not part.Name:find("Leg") and not part.Name:find("Torso") then
                    return true
                end
            end
        end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then
        return true
    end

    return false
end

