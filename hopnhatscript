                local tool = char:FindFirstChildOfClass("Tool")
                if tool and (tool.Name:lower():find("bat") or tool.Name:lower():find("weapon") or tool.Name:lower():find("stick")) then
                    tool:Activate()
                end

                -- Hit target nearby
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= LocalPlayer and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHRP = otherPlayer.Character.HumanoidRootPart
                        local dist = (targetHRP.Position - char.HumanoidRootPart.Position).Magnitude
                        if dist < 15 then
                            if tool then tool:Activate() end
                        end
                    end
                end
            end
        end
    end
end)

