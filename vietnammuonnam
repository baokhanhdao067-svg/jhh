-- Tải Thư viện Orion Library (Chạy cực mượt trên Delta Mobile)
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()
local Window = OrionLib:MakeWindow({
    Name = "Fishing Master | Hune x Toco Hub 🎣",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "FishingMasterConfig",
    IntroText = "Hune x Toco Hub Loaded!"
})

-- Service
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- Anti-AFK (Chống văng game khi treo máy lâu)
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- Tạo Nút Bật / Tắt Menu Nổi Dành Cho Điện Thoại (Delta)
local CoreGui = game:GetService("CoreGui")
if CoreGui:FindFirstChild("HuneTocoToggle") then
    CoreGui.HuneTocoToggle:Destroy()
end

local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "HuneTocoToggle"
ToggleGui.Parent = CoreGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Parent = ToggleGui
ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 85, 0)
ToggleBtn.Position = UDim2.new(0.02, 0, 0.25, 0)
ToggleBtn.Size = UDim2.new(0, 48, 0, 48)
ToggleBtn.Text = "🎣"
ToggleBtn.TextSize = 24
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Active = true
ToggleBtn.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = ToggleBtn

ToggleBtn.MouseButton1Click:Connect(function()
    if game:GetService("CoreGui"):FindFirstChild("Orion") then
        game:GetService("CoreGui").Orion.Enabled = not game:GetService("CoreGui").Orion.Enabled
    end
end)

-- ----------------------------------------------------------------- --
-- TAB 1: AUTO FARM (TỰ ĐỘNG CÂU CÁ SIÊU TOC)
-- ----------------------------------------------------------------- --
local FarmTab = Window:MakeTab({
    Name = "Auto Farm",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

_G.AutoCast = false
_G.AutoReel = false
_G.FastFish = false

FarmTab:AddToggle({
    Name = "Auto Cast (Tự Quăng Cần)",
    Default = false,
    Callback = function(Value) _G.AutoCast = Value end
})

FarmTab:AddToggle({
    Name = "Auto Reel Perfect (Tự Giật Cá Hoàn Hảo)",
    Default = false,
    Callback = function(Value) _G.AutoReel = Value end
})

FarmTab:AddToggle({
    Name = "Fast Fishing (Câu Cá Siêu Nhanh - Hune x Toco Mode)",
    Default = false,
    Callback = function(Value) _G.FastFish = Value end
})

task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if _G.AutoCast or _G.FastFish then
                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    for _, v in pairs(tool:GetDescendants()) do
                        if v:IsA("RemoteEvent") then v:FireServer() end
                    end
                end
            end
            
            if _G.AutoReel or _G.FastFish then
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("reel") or v.Name:lower():find("catch") or v.Name:lower():find("finish")) then
                        v:FireServer(100, true)
                    end
                end
            end
        end)
        if not _G.FastFish then task.wait(0.3) end
    end
end)

-- ----------------------------------------------------------------- --
-- TAB 2: AUTO QUEST (TỰ ĐỘNG LÀM NHIỆM VỤ & QUÀ)
-- ----------------------------------------------------------------- --
local QuestTab = Window:MakeTab({
    Name = "Nhiệm Vụ (Quest)",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

_G.AutoQuest = false
_G.AutoClaimReward = false

QuestTab:AddToggle({
    Name = "Auto Quest (Tự Nhận & Trả Nhiệm Vụ NPC)",
    Default = false,
    Callback = function(Value) _G.AutoQuest = Value end
})

QuestTab:AddToggle({
    Name = "Auto Claim Daily (Tự Nhận Quà Hàng Ngày / Phước)",
    Default = false,
    Callback = function(Value) _G.AutoClaimReward = Value end
})

task.spawn(function()
    while task.wait(1) do
        if _G.AutoQuest then
            pcall(function()
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                        local n = v.Name:lower()
                        if n:find("quest") or n:find("task") or n:find("nhiemvu") then
                            if v:IsA("RemoteEvent") then
                                v:FireServer("Accept")
                                v:FireServer("Claim")
                                v:FireServer("Complete")
                            end
                        end
                    end
                end
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                end
            end)
        end
        
        if _G.AutoClaimReward then
            pcall(function()
                for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("claim") or v.Name:lower():find("reward") or v.Name:lower():find("daily")) then
                        v:FireServer()
                    end
                end
            end)
        end
    end
end)

-- ----------------------------------------------------------------- --
-- TAB 3: DỊCH CHUYỂN ĐẢO (ISLAND TELEPORT)
-- ----------------------------------------------------------------- --
local TeleportTab = Window:MakeTab({
    Name = "Dịch Chuyển Đảo",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

local Islands = {
    ["Đảo Khởi Đầu (Spawn)"] = Vector3.new(0, 15, 0),
    ["Đảo Làng Chài"] = Vector3.new(150, 20, -300),
    ["Đảo Tuyết"] = Vector3.new(-800, 25, 500),
    ["Đảo Núi Lửa"] = Vector3.new(1200, 30, -900),
    ["Đảo Bầu Trời"] = Vector3.new(0, 500, 0),
    ["Đảo Sa Mạc / Cổ Đại"] = Vector3.new(-1500, 20, -1200),
    ["Đảo Vô Cực / Bí Ẩn"] = Vector3.new(2000, 15, 2000)
}

local SelectedIslandPos = Islands["Đảo Khởi Đầu (Spawn)"]

TeleportTab:AddDropdown({
    Name = "Chọn Đảo Cần Đến",
    Default = "Đảo Khởi Đầu (Spawn)",
    Options = {"Đảo Khởi Đầu (Spawn)", "Đảo Làng Chài", "Đảo Tuyết", "Đảo Núi Lửa", "Đảo Bầu Trời", "Đảo Sa Mạc / Cổ Đại", "Đảo Vô Cực / Bí Ẩn"},
    Callback = function(Value)
        if Islands[Value] then SelectedIslandPos = Islands[Value] end
    end
})

TeleportTab:AddButton({
    Name = "🚀 Dịch Chuyển Ngay Đến Đảo",
    Callback = function()
        pcall(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(SelectedIslandPos)
                OrionLib:MakeNotification({
                    Name = "Dịch Chuyển",
                    Content = "Đã tới đảo thành công!",
                    Time = 2
                })
            end
        end)
    end
})

