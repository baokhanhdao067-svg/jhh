local function renderList(scroll, list)
    for _, item in ipairs(list) do
        local f = Instance.new("Frame", scroll)
        f.Size = UDim2.new(1, -10, 0, 38)
        f.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 5)

        local lbl = Instance.new("TextLabel", f)
        lbl.Position = UDim2.new(0.03, 0, 0, 0)
        lbl.Size = UDim2.new(0.65, 0, 1, 0)
        lbl.Text = item.name
        lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.BackgroundTransparency = 1

        local btn = Instance.new("TextButton", f)
        btn.Position = UDim2.new(0.7, 0, 0.15, 0)
        btn.Size = UDim2.new(0.27, 0, 0.7, 0)
        btn.Text = "CHẠY"
        btn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            if item.copyKey and setclipboard then setclipboard(item.copyKey) end
            btn.Text = "ĐANG TẢI..."
            task.spawn(function()
                pcall(function() loadstring(game:HttpGet(item.url))() end)
                task.wait(1)
                btn.Text = "CHẠY"
            end)
        end)
    end
end

