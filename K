-- 5. BAY KHÔNG CẦN SÀN & CHỐNG CHẠM TOUCH/HITBOX (TRUE AIR FLY)
---------------------------------------------------------
local isAutoFly = false
local isFlying = false
local flyBodyVel = nil
local flyBodyGiro = nil
local targetHeight = 0

local function startTrueFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    -- Bay thẳng lên độ cao 45 stud
    targetHeight = hrp.Position.Y + 45
    hrp.CFrame = CFrame.new(hrp.Position.X, targetHeight, hrp.Position.Z)

    if not flyBodyVel then
        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBodyVel.Velocity = Vector3.zero
        flyBodyVel.Parent = hrp
    end

    if not flyBodyGiro then
        flyBodyGiro = Instance.new("BodyGyro")
        flyBodyGiro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBodyGiro.P = 10000
        flyBodyGiro.CFrame = hrp.CFrame
        flyBodyGiro.Parent = hrp
    end

    isFlying = true
    statusLabel.Text = "🚀 ĐÃ BAY LÊN KHÔNG - BẤT TỬ CHỐNG ĐÁNH!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

local function stopTrueFly()
    if flyBodyVel then flyBodyVel:Destroy(); flyBodyVel = nil end
    if flyBodyGiro then flyBodyGiro:Destroy(); flyBodyGiro = nil end
    isFlying = false
    statusLabel.Text = "Trạng thái: Chưa có trứng"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

autoFlyBtn.MouseButton1Click:Connect(function()
    isAutoFly = not isAutoFly
    autoFlyBtn.BackgroundColor3 = isAutoFly and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    autoFlyBtn.Text = "Lụm Trứng -> Bay & Bất Tử: " .. (isAutoFly and "BẬT" or "TẮT")
    if not isAutoFly then stopTrueFly() end
end)

RunService.Heartbeat:Connect(function()
    if isAutoFly then
        local hasEgg = isCarryingEggSpecial()
        if hasEgg and not isFlying then
            startTrueFly()
        elseif not hasEgg and isFlying then
            stopTrueFly()
        end
    end

    -- Khóa vị trí trục Y lơ lửng trên không trung khi di chuyển
    if isFlying and flyBodyVel then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            -- Giữ nhân vật luôn lơ lửng đúng độ cao targetHeight
            hrp.CFrame = CFrame.new(hrp.Position.X, targetHeight, hrp.Position.Z) * hrp.CFrame.Rotation
            
            if hum and hum.MoveDirection.Magnitude == 0 then
                flyBodyVel.Velocity = Vector3.zero
            end
        end
    end
end)

