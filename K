-- 4. LOGIC GIỮ TRỨNG
---------------------------------------------------------
local function isHoldingEgg()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item.Name:lower():find("egg") or item.Name:lower():find("trung") then return true end
        end
    end
    
    if char then
        for _, child in pairs(char:GetChildren()) do
            local n = child.Name:lower()
            if n:find("egg") or n:find("trung") or child:FindFirstChild("Egg") then return true end
        end
    end
    return false
end

---------------------------------------------------------
-- 5. CHỨC NĂNG 1: BAY VÚT LÊN KHI CÓ TRỨNG + ĐI TRÊN KHÔNG
---------------------------------------------------------
local isAutoFly = false
local isAirWalking = false
local airPlatform = nil

local function launchAndAirWalk()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    -- Bẩy lực đẩy nhân vật vút lên trời ngay lập tức
    hrp.CFrame = hrp.CFrame * CFrame.new(0, 40, 0)

    -- Sàn tàng hình đi trên không
    if not airPlatform or not airPlatform.Parent then
        airPlatform = Instance.new("Part")
        airPlatform.Size = Vector3.new(20, 1, 20)
        airPlatform.Transparency = 1
        airPlatform.Anchored = true
        airPlatform.CanCollide = true
        airPlatform.Parent = workspace
    end

    isAirWalking = true
    statusLabel.Text = "🚀 Đã phát hiện trứng -> Bay vút & đi trên không!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

local function stopAirWalk()
    if airPlatform then
        airPlatform:Destroy()
        airPlatform = nil
    end
    isAirWalking = false
    statusLabel.Text = "Trạng thái: Chưa có trứng"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

autoFlyBtn.MouseButton1Click:Connect(function()
    isAutoFly = not isAutoFly
    autoFlyBtn.BackgroundColor3 = isAutoFly and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    autoFlyBtn.Text = "Lụm Trứng -> Bay Vút Lên Không: " .. (isAutoFly and "BẬT" or "TẮT")
    if not isAutoFly then stopAirWalk() end
end)

RunService.Heartbeat:Connect(function()
    if isAutoFly then
        local hasEgg = isHoldingEgg()
        if hasEgg and not isAirWalking then
            launchAndAirWalk()
        elseif not hasEgg and isAirWalking then
            stopAirWalk()
        end
    end

    if isAirWalking and airPlatform then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local pos = char.HumanoidRootPart.Position
            airPlatform.CFrame = CFrame.new(pos.X, pos.Y - 3.2, pos.Z)
        end
    end
end)

