-- Tìm mục tiêu tối ưu theo FOV & Khoảng cách màn hình
local function getClosestPlayerInFOV()
    local target, minDistance = nil, Config.FOV
    local mousePos = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)

    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
            if Config.TeamCheck and p.Team == LP.Team then continue end
            
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local head = p.Character.Head
                local screenPos, onScreen = Cam:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < minDistance then
                        if Config.VisibleCheck then
                            local ray = Ray.new(Cam.CFrame.Position, (head.Position - Cam.CFrame.Position).Unit * 500)
                            local hit = workspace:FindPartOnWithIgnoreList(ray, {LP.Character})
                            if hit and hit:IsDescendantOf(p.Character) then
                                target = head
                                minDistance = dist
                            end
                        else
                            target = head
                            minDistance = dist
                        end
                    end
                end
            end
        end
    end
    return target
end

-- ESP Rendering Engine (Highlight + Box/Tracers/Info)
local espCache = {}

local function createESP(plr)
    if plr == LP then return end
    local drawings = {
        Box = Drawing.new("Square"),
        Tracer = Drawing.new("Line"),
        Text = Drawing.new("Text")
    }
    
    drawings.Box.Thickness = 1.5
    drawings.Box.Color = Color3.fromRGB(255, 50, 50)
    drawings.Box.Filled = false
    
    drawings.Tracer.Thickness = 1
    drawings.Tracer.Color = Color3.fromRGB(0, 255, 170)
    
    drawings.Text.Size = 13
    drawings.Text.Center = true
    drawings.Text.Outline = true
    drawings.Text.Color = Color3.fromRGB(255, 255, 255)
    
    espCache[plr] = drawings
end

for _, p in pairs(P:GetPlayers()) do createESP(p) end
P.PlayerAdded:Connect(createESP)
P.PlayerRemoving:Connect(function(p)
    if espCache[p] then
        for _, d in pairs(espCache[p]) do d:Remove() end
        espCache[p] = nil
    end
end)

-- Main Render Loop
R.RenderStepped:Connect(function()
    -- 1. Cập nhật FOV Circle
    FOVCircle.Position = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    FOVCircle.Radius = Config.FOV
    FOVCircle.Visible = Config.Aim and Config.FOVShow

    -- 2. Xử lý Aimbot Smooth
    if Config.Aim then
        local targetHead = getClosestPlayerInFOV()
        if targetHead then
            local targetCFrame = CFrame.new(Cam.CFrame.Position, targetHead.Position)
            Cam.CFrame = Cam.CFrame:Lerp(targetCFrame, Config.AimSmooth)
        end
    end

    -- 3. Xử lý Hitbox Expander
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local part = p.Character:FindFirstChild(Config.HitboxPart)
            if part then
                if not part:FindFirstChild("OrigSize") then
                    local orig = Instance.new("Vector3Value", part)
                    orig.Name = "OrigSize"
                    orig.Value = part.Size
                end
                part.Size = part.OrigSize.Value * Config.HitboxScale
                part.CanCollide = false
                part.Transparency = Config.HitboxScale > 1 and Config.HitboxTrans or 0
            end
        end
    end

    -- 4. Xử lý ESP Rendering
    for plr, d in pairs(espCache) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") then
            local hrp = plr.Character.HumanoidRootPart
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position)

            if onScreen and hum.Health > 0 then
                local head = plr.Character:FindFirstChild("Head")
                local headPos = head and Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos

                local height = math.abs(headPos.Y - pos.Y) * 2
                local width = height / 1.5

                -- Box ESP
                if Config.ESP_Box then
                    d.Box.Size = Vector2.new(width, height)
                    d.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    d.Box.Visible = true
                else d.Box.Visible = false end

                -- Tracers ESP
                if Config.ESP_Tracers then
                    d.Tracer.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                    d.Tracer.To = Vector2.new(pos.X, pos.Y)
                    d.Tracer.Visible = true
                else d.Tracer.Visible = false end

                -- Info ESP (Name & Health)
                if Config.ESP_Info then
                    local dist = math.floor((hrp.Position - Cam.CFrame.Position).Magnitude)
                    d.Text.Text = string.format("%s [%d m]\nHP: %d/%d", plr.Name, dist, math.floor(hum.Health), hum.MaxHealth)
                    d.Text.Position = Vector2.new(pos.X, pos.Y - height / 2 - 25)
                    d.Text.Visible = true
                else d.Text.Visible = false end
            else
                d.Box.Visible, d.Tracer.Visible, d.Text.Visible = false, false, false
            end
        else
            d.Box.Visible, d.Tracer.Visible, d.Text.Visible = false, false, false
        end
    end
end)

-- Auto AFK FPS Manager
local function resetAFKTimer()
    lastIn = os.time()
    if isAFK then isAFK = false; safeSetFPS(60) end
end
U.InputBegan:Connect(resetAFKTimer)
U.InputChanged:Connect(resetAFKTimer)

task.spawn(function()
    while task.wait(1) do
        if Config.AFK_FPS and (os.time() - lastIn >= 15) and not isAFK then
            isAFK = true
            safeSetFPS(15)
        end
    end
end)
