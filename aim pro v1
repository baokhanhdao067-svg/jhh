------------------- HỆ THỐNG XỬ LÝ LOGIC BACKEND -------------------

-- Tìm mục tiêu gần nhất
local function getClosest()
    local target, dist = nil, math.huge
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local d = (p.Character.Head.Position - Cam.CFrame.Position).Magnitude
                if d < dist then target, dist = p, d end
            end
        end
    end
    return target
end

-- Vòng lặp RenderStepped (Aimbot & Phóng Đầu Tối Ưu)
R.RenderStepped:Connect(function()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
            local hd = p.Character.Head
            if not hd:FindFirstChild("OrigSz") then
                local v = Instance.new("Vector3Value", hd) v.Name, v.Value = "OrigSz", hd.Size
            end
            local targetSize = hd.OrigSz.Value * S.Scale
            if hd.Size ~= targetSize then
                hd.Size = targetSize
                hd.CanCollide = false
            end
        end
    end

    if S.Aim then
        local t = getClosest()
        if t and t.Character and t.Character:FindFirstChild("Head") then
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, t.Character.Head.Position)
        end
    end
end)

-- Hệ thống ESP
local function createESP(plr, char)
    if plr == LP then return end
    task.wait(0.5)
    if char:FindFirstChild("KhanhDz_ESP") then char.KhanhDz_ESP:Destroy() end
    
    local hl = Instance.new("Highlight", char)
    hl.Name, hl.FillColor, hl.OutlineColor, hl.FillTransparency = "KhanhDz_ESP", Color3.fromRGB(255,0,0), Color3.fromRGB(255,255,255), 0.5
    hl.Enabled = S.ESP

    local hd = char:WaitForChild("Head", 5)
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hd and hum then
        if hd:FindFirstChild("HealthESP") then hd.HealthESP:Destroy() end
        local bb = Instance.new("BillboardGui", hd)
        bb.Name, bb.Adornee, bb.Size, bb.StudsOffset, bb.AlwaysOnTop = "HealthESP", hd, UDim2.new(0,100,0,30), Vector3.new(0,2,0), true
        bb.Enabled = S.ESP

        local txt = Instance.new("TextLabel", bb)
        txt.Size, txt.BackgroundTransparency, txt.TextColor3, txt.TextSize, txt.Font = UDim2.new(1,0,1,0), 1, Color3.fromRGB(0,255,0), 12, Enum.Font.GothamBold
        
        local function upd() 
            if hum and hum.Parent then
                txt.Text = string.format("%s\nHP: %d/%d", plr.Name, math.floor(math.max(hum.Health, 0)), hum.MaxHealth) 
            end
        end
        hum.HealthChanged:Connect(upd) 
        upd()
    end
end

local function setupPlayer(p)
    if p.Character then createESP(p, p.Character) end
    p.CharacterAdded:Connect(function(c) createESP(p, c) end)
end

for _, p in pairs(P:GetPlayers()) do setupPlayer(p) end
P.PlayerAdded:Connect(setupPlayer)

R.RenderStepped:Connect(function()
    for _, p in pairs(P:GetPlayers()) do
        if p ~= LP and p.Character then
            local hl = p.Character:FindFirstChild("KhanhDz_ESP")
            local bb = p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("HealthESP")
            if hl and hl.Enabled ~= S.ESP then hl.Enabled = S.ESP end
            if bb and bb.Enabled ~= S.ESP then bb.Enabled = S.ESP end
        end
    end
end)

-- Auto AFK Tracker (10 giây không thao tác hạ xuống 15 FPS)
local function resetAFK() 
    lastIn = os.time() 
    if isAFK then isAFK = false safeSetFPS(60) end 
end

U.InputBegan:Connect(resetAFK)
U.InputChanged:Connect(resetAFK)

task.spawn(function()
    while task.wait(1) do
        if S.AFK and (os.time() - lastIn >= 10) and not isAFK then
            isAFK = true
            safeSetFPS(15)
        end
    end
end)

-- Lắng nghe vật thể mới xuất hiện để tiếp tục tối ưu
workspace.DescendantAdded:Connect(function(v)
    if S.Textures then
        if v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic
        elseif v:IsA("Decal") or v:IsA("Texture") then v:Destroy() end
    end
    if S.Particles and (v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles")) then
        v.Enabled = false
    end
end)
