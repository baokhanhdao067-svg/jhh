-- 4. CHỨC NĂNG 1: ANTI-HIT (CHỐNG QUÁI ĐÁNH & CHỐNG RAGDOLL)
---------------------------------------------------------
local isAntiHit = false
local antiHitConn = nil

antiHitBtn.MouseButton1Click:Connect(function()
    isAntiHit = not isAntiHit
    antiHitBtn.BackgroundColor3 = isAntiHit and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    antiHitBtn.Text = "Chống Quái Đánh: " .. (isAntiHit and "BẬT" or "TẮT")

    if isAntiHit then
        antiHitConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                end
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if antiHitConn then antiHitConn:Disconnect(); antiHitConn = nil end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CanCollide = true
        end
    end
end)

---------------------------------------------------------
-- 5. CHỨC NĂNG 2: AUTO FLY KHI CÓ TRỨNG (QUÉT SÂU THỰC TẾ)
---------------------------------------------------------
local isAutoFly = false
local isFlying = false
local bodyPos = nil

local function startFlyUp()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if not bodyPos or not bodyPos.Parent then
        bodyPos = Instance.new("BodyPosition")
        bodyPos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bodyPos.D = 1200
        bodyPos.P = 10000
        -- Nâng nhân vật lên cao 35 stud so với vị trí hiện tại
        bodyPos.Position = char.HumanoidRootPart.Position + Vector3.new(0, 35, 0)
        bodyPos.Parent = char.HumanoidRootPart
    end
    isFlying = true
    statusLabel.Text = "🚀 ĐÃ PHÁT HIỆN TRỨNG -> ĐANG BAY LÊN!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

local function stopFly()
    if bodyPos then
        bodyPos:Destroy()
        bodyPos = nil
    end
    isFlying = false
    statusLabel.Text = "Trạng thái: Chưa nhặt trứng"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

-- Hàm kiểm tra xem nhân vật/balo có đang giữ trứng hay không
local function isHoldingEgg()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    -- Quét trong balo
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item.Name:lower():find("egg") or item.Name:lower():find("trung") then
                return true
            end
        end
    end
    
    -- Quét trực tiếp trên người (bao gồm Tool, Model hoặc Part được Weld vào người)
    if char then
        for _, child in pairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Model") or child:IsA("Part") or child:IsA("MeshPart") then
                local n = child.Name:lower()
                if n:find("egg") or n:find("trung") or child:FindFirstChild("Egg") then
                    return true
                end
            end
        end
    end
    return false
end

autoFlyBtn.MouseButton1Click:Connect(function()
    isAutoFly = not isAutoFly
    autoFlyBtn.BackgroundColor3 = isAutoFly and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    autoFlyBtn.Text = "Lụm Trứng Tự Bay Lên: " .. (isAutoFly and "BẬT" or "TẮT")
    
    if not isAutoFly then
        stopFly()
    end
end)

RunService.Heartbeat:Connect(function()
    if isAutoFly then
        local hasEgg = isHoldingEgg()
        if hasEgg and not isFlying then
            startFlyUp()
        elseif not hasEgg and isFlying then
            stopFly()
        end
    end
end)

