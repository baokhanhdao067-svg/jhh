local luckEnabled = false
local luckLoop = nil

-- Hàm quét và can thiệp Luck đa game
local function applySuperLuck()
    local lp = game.Players.LocalPlayer
    
    -- 1. Tìm các giá trị Luck trong Player/Stats
    local targets = {lp, lp:FindFirstChild("leaderstats"), lp:FindFirstChild("Stats")}
    for _, parent in pairs(targets) do
        if parent then
            for _, child in pairs(parent:GetChildren()) do
                if string.find(string.lower(child.Name), "luck") then
                    pcall(function() child.Value = 999999 end)
                end
            end
        end
    end
    
    -- 2. Gửi tín hiệu kích hoạt Boost Luck qua RemoteEvents
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") and string.find(string.lower(v.Name), "luck") then
            pcall(function()
                v:FireServer(true)
                v:FireServer("SuperLuck", 999999)
            end)
        end
    end
end

-- Logic Bật / Tắt
ToggleBtn.MouseButton1Click:Connect(function()
    luckEnabled = not luckEnabled
    
    if luckEnabled then
        ToggleBtn.Text = "BUFF LUCK: ON 🚀"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        
        -- Chạy vòng lặp buff liên tục
        luckLoop = task.spawn(function()
            while luckEnabled do
                applySuperLuck()
                task.wait(1)
            end
        end)
    else
        ToggleBtn.Text = "BUFF LUCK: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        if luckLoop then
            task.cancel(luckLoop)
        end
    end
end)
