-- Tải thư viện Orion UI
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

-- Tạo Cửa Sổ Menu
local Window = OrionLib:MakeWindow({
    Name = "Buff Menu - Delta", 
    HidePremium = true, 
    SaveConfig = false, 
    ConfigFolder = "DeltaBuffMenu"
})

-- Tạo Tab Chức Năng
local MainTab = OrionLib:MakeTab({
    Name = "Chức Năng",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Giá trị mặc định là 10
local jumpValue = 10
local speedValue = 10

-- --- CHỨC NĂNG 1: BUFF SỨC NHẢY (MAX 1000) ---
MainTab:AddSection({ Name = "Tùy Chỉnh Sức Nhảy" })

MainTab:AddTextbox({
    Name = "Nhập Sức Nhảy (Max 1000)",
    Default = "10",
    TextDisappear = false,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            if num > 1000 then num = 1000 end
            jumpValue = num
        end
    end	
})

MainTab:AddToggle({
    Name = "Bật/Tắt Buff Nhảy",
    Default = false,
    Callback = function(Value)
        local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            if Value then
                hum.UseJumpPower = true
                hum.JumpPower = jumpValue
            else
                hum.JumpPower = 50 -- Trở về mặc định Roblox
            end
        end
    end    
})

-- --- CHỨC NĂNG 2: BUFF TỐC ĐỘ ---
MainTab:AddSection({ Name = "Tùy Chỉnh Tốc Độ" })

MainTab:AddTextbox({
    Name = "Nhập Tốc Độ Chạy",
    Default = "10",
    TextDisappear = false,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            speedValue = num
        end
    end	
})

MainTab:AddToggle({
    Name = "Bật/Tắt Buff Tốc Độ",
    Default = false,
    Callback = function(Value)
        local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            if Value then
                hum.WalkSpeed = speedValue
            else
                hum.WalkSpeed = 16 -- Trở về mặc định Roblox
            end
        end
    end    
})

-- --- TẠO NÚT BẬT/TẮT MENU TRÊN MÀN HÌNH (Dành riêng cho Delta Mobile) ---
local ScreenGui = Instance.new("ScreenGui")
local ToggleBtn = Instance.new("TextButton")

ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "DeltaToggleGui"

ToggleBtn.Parent = ScreenGui
ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleBtn.Position = UDim2.new(0, 10, 0.5, -25)
ToggleBtn.Size = UDim2.new(0, 50, 0, 50)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.Text = "MENU"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 14
ToggleBtn.Draggable = true -- Có thể kéo di chuyển nút trên màn hình

-- Bo tròn nút cho đẹp
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = ToggleBtn

-- Logic Bật/Tắt Menu khi bấm vào nút
ToggleBtn.MouseButton1Click:Connect(function()
    OrionLib:ToggleUI()
end)

OrionLib:Init()
