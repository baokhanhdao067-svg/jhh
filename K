-- FIX LỖI NHẶT TRỨNG GAME UPDATE (CƠ CHẾ PROXIMITY PROMPT & REMOTE)
---------------------------------------------------------
local function forceStealEgg(eggObject)
    if not eggObject then return end
    
    -- 1. Kích hoạt toàn bộ ProximityPrompt có trong viên trứng (Cách nhặt chính chủ)
    for _, prompt in pairs(eggObject:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.01)
                prompt:InputHoldEnd()
            end
        end
    end

    -- 2. Kích hoạt ClickDetector nếu game đổi sang cơ chế Click
    for _, clicker in pairs(eggObject:GetDescendants()) do
        if clicker:IsA("ClickDetector") and fireclickdetector then
            fireclickdetector(clicker)
        end
    end

    -- 3. Dò tìm RemoteEvent ẩn để trigger nhặt trứng trực tiếp từ Server
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
            local rName = remote.Name:lower()
            if rName:find("steal") or rName:find("egg") or rName:find("pick") or rName:find("grab") or rName:find("collect") then
                pcall(function()
                    remote:FireServer(eggObject)
                end)
            end
        end
    end
end

---------------------------------------------------------
-- NHẬN DIỆN MANG TRỨNG & QUÉT TRỨNG TỐI ƯU
---------------------------------------------------------
local function isCarryingEgg()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then
            return true
        end
    end

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Tool") then
            if part:FindFirstChildOfClass("Weld") or part:FindFirstChildOfClass("WeldConstraint") then
                if part.Name ~= "HumanoidRootPart" and not part.Name:find("Head") and not part.Name:find("Arm") and not part.Name:find("Leg") and not part.Name:find("Torso") then
                    return true
                end
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then
        return true
    end

    return false
end

local function getTargetEgg()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local closestEgg = nil
    local shortestDist = 2000

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            local name = v.Name:lower()
            if (name:find("egg") or name:find("trung")) and not v:IsDescendantOf(char) then
                local pos = v:IsA("Model") and (v.PrimaryPart and v.PrimaryPart.Position or v:GetAttribute("Position")) or v.Position
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestEgg = {Object = v, Position = pos}
                    end
                end
            end
        end
    end
    return closestEgg
end

---------------------------------------------------------
-- ENGINE GLIDE & INSTANT TELEPORT
---------------------------------------------------------
local isMovingToTarget = false

local function smartMoveTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    isMovingToTarget = true
    if hum then hum.PlatformStand = true end

    while isMovingToTarget and char and hrp do
        local currentPos = hrp.Position
        local targetGround = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
        local dir = (targetGround - currentPos)
        local dist = dir.Magnitude

        if dist < 3 then break end

        local step = math.min(dist, Config.Speed * task.wait())
        hrp.CFrame = CFrame.new(currentPos + (dir.Unit * step))
    end

    if hum then hum.PlatformStand = false end
    isMovingToTarget = false
end

---------------------------------------------------------
-- AUTOMATION MAIN LOOP
---------------------------------------------------------
task.spawn(function()
    while task.wait(0.03) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart

            -- TH1: Đang cầm trứng -> Auto Return về Base
            if Config.AutoReturn and isCarryingEgg() then
                smartMoveTo(BASE_SAFE_POS)

            -- TH2: Đang mở Auto Steal / Auto Pick -> Tìm trứng để cướp & nhặt
            elseif (Config.AutoSteal or Config.AutoPickDrop) and not isCarryingEgg() then
                local eggData = getTargetEgg()
                if eggData then
                    if Config.FastInstantSteal then
                        -- Teleport siêu tốc tức thì tới sát viên trứng
                        hrp.CFrame = CFrame.new(eggData.Position + Vector3.new(0, 1.5, 0))
                        forceStealEgg(eggData.Object)
                        task.wait(0.05)
                    else
                        smartMoveTo(eggData.Position)
                        forceStealEgg(eggData.Object)
                    end
                end
            end

            -- TH3: Auto Hatch / Auto Sell (Gửi RemoteEvent nền)
            if Config.AutoHatch or Config.AutoSell then
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local rName = remote.Name:lower()
                        if Config.AutoHatch and (rName:find("hatch") or rName:find("open")) then
                            pcall(function() remote:FireServer() end)
                        end
                        if Config.AutoSell and (rName:find("sell") or rName:find("delete")) then
                            pcall(function() remote:FireServer() end)
                        end
                    end
                end
            end

        end
    end
end)

