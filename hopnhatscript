-- [[ STEAL AN EGG - ULTIMATE SUPER HUB (Chili + Pulse Zax + Limbo) ]] --
-- Integrated with Fluent UI & Floating Toggle Button --

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

-- Window Setup
local Window = Fluent:CreateWindow({
    Title = "Steal an Egg 🥚 | Super Hub Ultimate",
    SubTitle = "Chili x Pulse Zax x Limbo",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Darker",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- TABS CREATION
local Tabs = {
    Main = Window:AddTab({ Title = "Auto Farm", Icon = "egg" }),
    ESP = Window:AddTab({ Title = "ESP & Visuals", Icon = "eye" }),
    Player = Window:AddTab({ Title = "Player & Speed", Icon = "user" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- GLOBAL VARIABLES & STATES
local Options = Fluent.Options
local States = {
    AutoSteal = false,
    AutoCollect = false,
    EggESP = false,
    PlayerESP = false,
    WalkSpeed = 16,
    JumpPower = 50,
    Noclip = false
}

--------------------------------------------------------------------
-- 1. AUTO FARM TAB (Combo Best Features from Chili & Limbo)
--------------------------------------------------------------------
Tabs.Main:AddSection("Egg Automation")

local ToggleSteal = Tabs.Main:AddToggle("AutoSteal", {Title = "Auto Steal Eggs (Fastest)", Default = false })
ToggleSteal:OnChanged(function()
    States.AutoSteal = Options.AutoSteal.Value
    task.spawn(function()
        while States.AutoSteal do
            task.wait(0.1)
            pcall(function()
                -- Logic Auto Steal Eggs tối ưu hóa từ Chili & Limbo Hub
                for _, egg in pairs(workspace:GetChildren()) do
                    if egg:FindFirstChild("TouchInterest") or egg.Name:lower():find("egg") then
                        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, egg, 0)
                            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, egg, 1)
                        end
                    end
                end
            end)
        end
    end)
end)

local ToggleCollect = Tabs.Main:AddToggle("AutoCollect", {Title = "Auto Collect Spawned Eggs", Default = false })
ToggleCollect:OnChanged(function()
    States.AutoCollect = Options.AutoCollect.Value
    task.spawn(function()
        while States.AutoCollect do
            task.wait(0.2)
            pcall(function()
                -- Logic nhặt trứng tự động xung quanh map
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") then
                        fireproximityprompt(obj)
                    end
                end
            end)
        end
    end)
end)

--------------------------------------------------------------------
-- 2. ESP & VISUALS TAB (Best Features from Pulse Zax)
--------------------------------------------------------------------
Tabs.ESP:AddSection("Visual Enhancements")

local ToggleEggESP = Tabs.ESP:AddToggle("EggESP", {Title = "Egg ESP (Highlight Eggs)", Default = false })
ToggleEggESP:OnChanged(function()
    States.EggESP = Options.EggESP.Value
    if not States.EggESP then
        for _, v in pairs(workspace:GetChildren()) do
            if v:FindFirstChild("EggHighlight") then
                v.EggHighlight:Destroy()
            end
        end
    else
        task.spawn(function()
            while States.EggESP do
                for _, egg in pairs(workspace:GetChildren()) do
                    if egg.Name:lower():find("egg") and not egg:FindFirstChild("EggHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "EggHighlight"
                        hl.FillColor = Color3.fromRGB(255, 215, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = egg
                    end
                end
                task.wait(1)
            end
        end)
    end
end)

local TogglePlayerESP = Tabs.ESP:AddToggle("PlayerESP", {Title = "Player ESP", Default = false })
TogglePlayerESP:OnChanged(function()
    States.PlayerESP = Options.PlayerESP.Value
    -- Player ESP Logic
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= game.Players.LocalPlayer and plr.Character then
            if States.PlayerESP then
                if not plr.Character:FindFirstChild("PlayerHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "PlayerHighlight"
                    hl.FillColor = Color3.fromRGB(255, 0, 85)
                    hl.Parent = plr.Character
                end
            else
                if plr.Character:FindFirstChild("PlayerHighlight") then
                    plr.Character.PlayerHighlight:Destroy()
                end
            end
        end
    end
end)

--------------------------------------------------------------------
-- 3. PLAYER & MOVEMENT TAB
--------------------------------------------------------------------
Tabs.Player:AddSection("Movement Mods")

local SpeedSlider = Tabs.Player:AddSlider("SpeedSlider", {
    Title = "WalkSpeed Modifier",
    Min = 16,
    Max = 150,
    Default = 16,
    Rounding = 0,
    Callback = function(Value)
        States.WalkSpeed = Value
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
        end
    end
})

local JumpSlider = Tabs.Player:AddSlider("JumpSlider", {
    Title = "JumpPower Modifier",
    Min = 50,
    Max = 250,
    Default = 50,
    Rounding = 0,
    Callback = function(Value)
        States.JumpPower = Value
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
        end
    end
})

game:GetService("RunService").RenderStepped:Connect(function()
    pcall(function()
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = States.WalkSpeed
        end
    end)
end)

--------------------------------------------------------------------
-- 4. FLOATING TOGGLE BUTTON (Nút Bật/Tắt Giao Diện Siêu Mượt)
--------------------------------------------------------------------
local ScreenGui = Instance.new("ScreenGui")
local ToggleBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")
local UIStroke = Instance.new("UIStroke")

ScreenGui.Name = "SuperHubToggleGui"
ScreenGui.Parent = game:GetService("CoreGui") or game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

ToggleBtn.Name = "ToggleButton"
ToggleBtn.Parent = ScreenGui
ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
ToggleBtn.Position = UDim2.new(0, 15, 0.4, 0)
ToggleBtn.Size = UDim2.new(0, 50, 0, 50)
ToggleBtn.Font = Enum.Font.Garamond
ToggleBtn.Text = "🥚"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 26
ToggleBtn.Active = true
ToggleBtn.Draggable = true

UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = ToggleBtn

UIStroke.Parent = ToggleBtn
UIStroke.Thickness = 2
UIStroke.Color = Color3.fromRGB(255, 0, 100)
UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

-- Hiệu ứng Glow/Bật Tắt
local isOpen = true
ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
    
    if isOpen then
        UIStroke.Color = Color3.fromRGB(255, 0, 100)
    else
        UIStroke.Color = Color3.fromRGB(80, 80, 80)
    end
end)

-- Khởi tạo cài đặt giao diện
InterfaceManager:SetLibrary(Fluent)
SaveManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({})
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)

Window:SelectTab(1)
Fluent:Notify({
    Title = "Super Hub Loaded!",
    Content = "Chili + Pulse Zax + Limbo combo ready to use.",
    Duration = 5
})
