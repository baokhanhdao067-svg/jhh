-- Xử lý Logic Hop & Auto Hop
_G.AutoHopEnabled = false
_G.MaxPlayersHop = 1

local function executeServerHop()
    _G.MaxPlayersHop = tonumber(PlayerInput.Text) or 1
    local hopUrl = "https://raw.githubusercontent.com/Bubu2k/Rubutv/refs/heads/main/RubuHopSeverlow.lua"
    pcall(function()
        loadstring(game:HttpGet(hopUrl))()
    end)
end

HopButton.MouseButton1Click:Connect(function()
    HopButton.Text = "ĐANG CHUYỂN SERVER..."
    executeServerHop()
end)

AutoHopButton.MouseButton1Click:Connect(function()
    _G.AutoHopEnabled = not _G.AutoHopEnabled
    if _G.AutoHopEnabled then
        AutoHopButton.Text = "⚡ AUTO HOP: BẬT ✓"
        AutoHopButton.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
        task.spawn(function()
            while _G.AutoHopEnabled do
                executeServerHop()
                task.wait(10)
            end
        end)
    else
        AutoHopButton.Text = "⚡ AUTO HOP: TẮT"
        AutoHopButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

