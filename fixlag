        isAFK = false
    end
end)

-- 6. Dọn Rác Máy Chủ Định Kỳ (Clear Memory Heap)
AddToggle("🧹 Tự Động Giải Phóng RAM", function(v)
    if v then
        task.spawn(function()
            while v do
                task.wait(60)
                pcall(function()
                    game:GetService("ContentProvider"):PreloadAsync({})
                    collectgarbage("collect")
                end)
            end
        end)
    end
end)

------------------- HỆ THỐNG QUẢN LÝ TỰ ĐỘNG (BACKEND) -------------------

-- Lắng nghe khi di chuyển/chạm màn hình để thoát AFK Mode
local function resetAFKTimer()
    lastInput = os.time()
    if isAFK then
        isAFK = false
        setFPS(60)
    end
end

U.InputBegan:Connect(resetAFKTimer)
U.InputChanged:Connect(resetAFKTimer)

-- Thread theo dõi thời gian AFK
task.spawn(function()
    while task.wait(1) do
        if Settings.AFKMode and (os.time() - lastInput >= 10) and not isAFK then
            isAFK = true
            setFPS(15) -- Giảm FPS về 15 để máy mát tuyệt đối khi treo game
        end
    end
end)

-- Lắng nghe vật thể mới tạo ra trong Game để tự động xoá Lag
workspace.DescendantAdded:Connect(function(v)
    if Settings.UltraLagFix or Settings.NoTextures then
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.CastShadow = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v:Destroy()
        end
    end
    if Settings.UltraLagFix or Settings.NoParticles then
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        end
    end
end)
