-- CORE AUTO LOOP
---------------------------------------------------------
task.spawn(function()
    while task.wait(0.05) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            
            -- Trạng thái 1: Đang mang trứng -> Lướt tốc độ cao về Base
            if Config.AutoReturn and isCarryingEgg() then
                smartGlideTo(BASE_SAFE_POS)
            
            -- Trạng thái 2: Tự động lụm trứng rơi / Trứng trên đất
            elseif Config.AutoPickDrop and not isCarryingEgg() then
                local eggData = getNearestEgg()
                if eggData then
                    -- Hút / Dịch chuyển siêu tốc tức thì tới trứng
                    char.HumanoidRootPart.CFrame = CFrame.new(eggData.Position + Vector3.new(0, 1.5, 0))
                    task.wait(0.08)
                end
            end

        end
    end
end)

