-- HELPER FUNCTIONS
---------------------------------------------------------
local function isCarryingEgg()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then return true end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then return true end

    return false
end

local function getClosestEgg()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local closestEgg = nil
    local shortestDist = 5000

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            local name = v.Name:lower()
            if (name:find("egg") or name:find("trung")) and not v:IsDescendantOf(char) then
                local pos = v:IsA("Model") and (v.PrimaryPart and v.PrimaryPart.Position or v:GetAttribute("Position")) or v.Position
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestEgg = {Object = v, Position = pos}
                    end
                end
            end
        end
    end
    return closestEgg
end

