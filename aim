local function getAllTargets()
    local targets = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isValidTarget(p.Character) then
            table.insert(targets, p.Character)
        end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isValidTarget(obj) and not Players:GetPlayerFromCharacter(obj) then
            table.insert(targets, obj)
        end
    end
    return targets
end

local function getNearestTarget()
    local nearest = nil
    local shortestDist = math.huge
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        for _, char in pairs(getAllTargets()) do
            local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if root then
                local dist = (root.Position - myPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearest = char
                end
            end
        end
    end
    return nearest
end

-- ==================== VÒNG LẶP XỬ LÝ ====================

-- 1. AIMBOT
RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local closestHead = nil
        local shortestDist = fovRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, char in pairs(getAllTargets()) do
            local head = char:FindFirstChild("Head")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if dist <= shortestDist then
                        shortestDist = dist
                        closestHead = head
                    end
                end
            end
        end
        if closestHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
        end
    end
end)

-- 2. AUTO TELE + BÁM + VIRTUAL CLICK (GIẢ LẬP CLICK CHUỘT THẬT)
RunService.RenderStepped:Connect(function()
    if teleKillEnabled then
        if not selectedTarget or not selectedTarget.Parent or (selectedTarget:FindFirstChildOfClass("Humanoid") and selectedTarget.Humanoid.Health <= 0) then
            selectedTarget = getNearestTarget()
        end
        
        if selectedTarget then
            local targetHRP = selectedTarget:FindFirstChild("HumanoidRootPart") or selectedTarget:FindFirstChild("Torso")
            local myChar = LocalPlayer.Character
            if myChar and targetHRP then
                local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.5)
                    equipWeapon()
                    
                    -- Dùng VirtualUser để giả lập thao tác click chuột thật nhằm ép game tính sát thương
                    pcall(function()
                        VirtualUser:Button1Down(Vector2.new(0,0))
                        task.wait(0.02)
                        VirtualUser:Button1Up(Vector2.new(0,0))
                    end)
                end
            end
        end
    end
end)

