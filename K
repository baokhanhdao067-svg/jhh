-- 5. LOGIC BAY TỰ ĐỘNG VỀ NHÀ & RỚT TRỨNG
---------------------------------------------------------
local isAutoFly = false
local isFlying = false
local flyBodyVel = nil
local flyBodyGyro = nil
local flyHeightOffset = 35 -- Độ cao bay an toàn

local function startFlyToHome()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if not flyBodyVel then
        flyBodyVel = Instance.new("BodyVelocity")
        flyBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBodyVel.Velocity = Vector3.zero
        flyBodyVel.Parent = hrp
    end

    if not flyBodyGyro then
        flyBodyGyro = Instance.new("BodyGyro")
        flyBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBodyGyro.P = 10000
        flyBodyGyro.CFrame = hrp.CFrame
        flyBodyGyro.Parent = hrp
    end

    isFlying = true
    statusLabel.Text = "🚀 ĐÃ NHẶT TRỨNG -> ĐANG BAY VỀ NHÀ!"
    statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
end

local function stopFly()
    if flyBodyVel then flyBodyVel:Destroy(); flyBodyVel = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    isFlying = false
    statusLabel.Text = "Trạng thái: Đã về nhà / Đang chờ nhặt trứng..."
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

autoFlyBtn.MouseButton1Click:Connect(function()
    isAutoFly = not isAutoFly
    autoFlyBtn.BackgroundColor3 = isAutoFly and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    autoFlyBtn.Text = "Lụm Trứng -> Bay Về Nhà: " .. (isAutoFly and "BẬT" or "TẮT")
    if not isAutoFly then stopFly() end
end)

RunService.Heartbeat:Connect(function()
    if not isAutoFly then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    local hasEgg = isCarryingEggSpecial()

    if hasEgg then
        if not isFlying then
            startFlyToHome()
        end

        local basePos = getMyBasePosition()
        local targetFlyPos = Vector3.new(basePos.X, basePos.Y + flyHeightOffset, basePos.Z)
        local flatDistance = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(basePos.X, 0, basePos.Z)).Magnitude
        local speed = tonumber(speedBox.Text) or 500

        -- Tiến gần đến nhà
        if flatDistance > 12 then
            local moveDir = (targetFlyPos - hrp.Position).Unit
            flyBodyVel.Velocity = moveDir * speed
            flyBodyGyro.CFrame = CFrame.new(hrp.Position, targetFlyPos)
        else
            -- Đã sát nhà -> Từ từ hạ độ cao xuống để thả trứng
            statusLabel.Text = "🪂 ĐÃ VỀ TỚI NHÀ -> HẠ CÁNH THẢ TRỨNG..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
            
            local dropTarget = Vector3.new(basePos.X, basePos.Y + 2, basePos.Z)
            local dropDir = (dropTarget - hrp.Position).Unit
            flyBodyVel.Velocity = dropDir * 50
            flyBodyGyro.CFrame = CFrame.new(hrp.Position, dropTarget)
        end
    else
        if isFlying then
            stopFly()
        end
    end
end)

