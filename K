-- 2. HÀM FIX LỖI NHẶT TRỨNG GAME UPDATE
local function forceCollectEgg(eggObject)
    if not eggObject then return end

    -- Cách A: Kích hoạt ProximityPrompt trực tiếp
    for _, prompt in pairs(eggObject:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.01)
                prompt:InputHoldEnd()
            end
        end
    end

    -- Cách B: Dò RemoteEvent bị đổi tên trong ReplicatedStorage
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
            local name = obj.Name:lower()
            if name:find("steal") or name:find("egg") or name:find("pick") or name:find("grab") or name:find("collect") or name:find("claim") then
                pcall(function()
                    obj:FireServer(eggObject)
                end)
            end
        end
    end
end

-- 3. KIỂM TRẢ XEM ĐANG CẦM TRỨNG HAY KHÔNG
local function isCarryingEgg()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then return true end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then return true end

    return false
end

-- 4. QUÉT TÌM TRỨNG GẦN NHẤT
local function getTargetEgg()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local closestEgg = nil
    local shortestDist = 5000

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            local name = v.Name:lower()
            if (name:find("egg") or name:find("trung")) and not v:IsDescendantOf(char) then
                local pos = v:IsA("Model") and (v.PrimaryPart and v.PrimaryPart.Position or v:GetAttribute("Position")) or v.Position
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestEgg = {Object = v, Position = pos}
                    end
                end
            end
        end
    end
    return closestEgg
end

-- 5. VÒNG LẶP CHÍNH (MAIN LOOP)
task.spawn(function()
    while task.wait(0.02) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart

            -- Auto Steal / Pick
            if (Config.AutoSteal or Config.AutoPickDrop) and not isCarryingEgg() then
                local egg = getTargetEgg()
                if egg then
                    -- Teleport sát viên trứng để Bypass check khoảng cách của Server
                    hrp.CFrame = CFrame.new(egg.Position + Vector3.new(0, 1.5, 0))
                    forceCollectEgg(egg.Object)
                    task.wait(0.05)
                end
            elseif Config.AutoReturn and isCarryingEgg() then
                hrp.CFrame = CFrame.new(BASE_SAFE_POS)
            end

            -- Auto Hatch & Sell Background
            if Config.AutoHatch or Config.AutoSell then
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local rName = remote.Name:lower()
                        if Config.AutoHatch and (rName:find("hatch") or rName:find("open")) then
                            pcall(function() remote:FireServer() end)
                        end
                        if Config.AutoSell and (rName:find("sell") or rName:find("delete")) then
                            pcall(function() remote:FireServer() end)
                        end
                    end
                end
            end
        end
    end
end)

