-- 6. CHỨC NĂNG 2: SIÊU TỐC ĐỘ MAX 10,000 (TỰ NHẬP SỐ)
---------------------------------------------------------
local isSpeedEnabled = false
local currentSpeed = 100

speedBox.FocusLost:Connect(function()
    local num = tonumber(speedBox.Text)
    if num then
        currentSpeed = math.clamp(num, 1, 10000)
        speedBox.Text = tostring(currentSpeed)
    else
        speedBox.Text = tostring(currentSpeed)
    end
end)

speedToggleBtn.MouseButton1Click:Connect(function()
    isSpeedEnabled = not isSpeedEnabled
    speedToggleBtn.BackgroundColor3 = isSpeedEnabled and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    speedToggleBtn.Text = "Bật Siêu Tốc Độ: " .. (isSpeedEnabled and "BẬT" or "TẮT")
end)

-- Can thiệp trực tiếp Vận Tốc Vật Lý (Bỏ qua mọi hiệu ứng đi chậm)
RunService.RenderStepped:Connect(function()
    if isSpeedEnabled then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.MoveDirection.Magnitude > 0 then
                local moveDir = hum.MoveDirection
                hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * currentSpeed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * currentSpeed)
            end
        end
    end
end)

