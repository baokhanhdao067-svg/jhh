local function createScrollFrame(name)
    local sf = Instance.new("ScrollingFrame")
    sf.Name = name
    sf.Parent = MainFrame
    sf.Active = true
    sf.BackgroundTransparency = 1.000
    sf.Position = UDim2.new(0.03, 0, 0.25, 0)
    sf.Size = UDim2.new(0.94, 0, 0.71, 0)
    sf.CanvasSize = UDim2.new(0, 0, 0, 200)
    sf.ScrollBarThickness = 6
    sf.Visible = false

    local layout = Instance.new("UIListLayout")
    layout.Parent = sf
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)

    return sf
end

