task.spawn(function()
    while task.wait(0.02) do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart

            -- Logic 1: Auto Steal / Pick Egg
            if (Config.AutoSteal or Config.AutoPickDrop) and not isCarryingEgg() then
                local egg = getClosestEgg()
                if egg then
                    hrp.CFrame = CFrame.new(egg.Position + Vector3.new(0, 1.5, 0))
                    forceCollectEgg(egg.Object)
                    task.wait(0.05)
                end
            -- Logic 2: Auto Return Base
            elseif Config.AutoReturn and isCarryingEgg() then
                hrp.CFrame = CFrame.new(SAFE_BASE_POS)
            end

            -- Logic 3: Chilli Auto Hatch & Sell
            if Config.AutoHatch or Config.AutoSell then
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local rName = remote.Name:lower()
                        if Config.AutoHatch and (rName:find("hatch") or rName:find("open")) then
                            pcall(function() remote:FireServer() end)
                        end
                        if Config.AutoSell and (rName:find("sell") or rName:find("delete")) then
                            pcall(function() remote:FireServer() end)
                        end
                    end
                end
            end
        end
    end
end)

