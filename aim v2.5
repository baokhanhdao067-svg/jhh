-- UI Creators
local function AddToggle(name, default, callback)
    local B = Instance.new("TextButton", Scroll)
    B.Name = name
    B.Size, B.BackgroundColor3 = UDim2.new(0,240,0,35), default and Color3.fromRGB(0,180,120) or Color3.fromRGB(32,32,42)
    B.Text, B.TextColor3, B.Font, B.TextSize = "  "..name, Color3.fromRGB(220,220,220), Enum.Font.GothamSemibold, 12
    B.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", B).CornerRadius = UDim.new(0,6)
    
    local Indicator = Instance.new("Frame", B)
    Indicator.Size, Indicator.Position = UDim2.new(0,14,0,14), UDim2.new(1,-24,0.5,-7)
    Indicator.BackgroundColor3 = default and Color3.fromRGB(0,255,170) or Color3.fromRGB(80,80,95)
    Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1,0)

    local st = default
    B.MouseButton1Click:Connect(function()
        st = not st
        B.BackgroundColor3 = st and Color3.fromRGB(0,180,120) or Color3.fromRGB(32,32,42)
        Indicator.BackgroundColor3 = st and Color3.fromRGB(0,255,170) or Color3.fromRGB(80,80,95)
        callback(st)
    end)
end

local function AddSlider(name, min, max, default, unit, callback)
    local Cont = Instance.new("Frame", Scroll)
    Cont.Name = name
    Cont.Size, Cont.BackgroundTransparency = UDim2.new(0,240,0,45), 1

    local Lbl = Instance.new("TextLabel", Cont)
    Lbl.Size, Lbl.Text = UDim2.new(1,0,0,18), string.format("%s: %d%s", name, default, unit)
    Lbl.BackgroundTransparency, Lbl.TextColor3, Lbl.Font, Lbl.TextSize = 1, Color3.fromRGB(180,180,200), Enum.Font.Gotham, 11
    Lbl.TextXAlignment = Enum.TextXAlignment.Left

    local SFrame = Instance.new("Frame", Cont)
    SFrame.Size, SFrame.Position, SFrame.BackgroundColor3 = UDim2.new(1,0,0,8), UDim2.new(0,0,0,22), Color3.fromRGB(35,35,45)
    Instance.new("UICorner", SFrame).CornerRadius = UDim.new(1,0)

    local valPct = (default - min) / (max - min)
    local SFill = Instance.new("Frame", SFrame)
    SFill.Size, SFill.BackgroundColor3 = UDim2.new(valPct, 0, 1, 0), Color3.fromRGB(0,255,170)
    Instance.new("UICorner", SFill).CornerRadius = UDim.new(1,0)

    local dragging = false
    local function update(input)
        local pct = math.clamp((input.Position.X - SFrame.AbsolutePosition.X) / SFrame.AbsoluteSize.X, 0, 1)
        SFill.Size = UDim2.new(pct, 0, 1, 0)
        local val = math.floor(min + (max - min) * pct)
        Lbl.Text = string.format("%s: %d%s", name, val, unit)
        callback(val)
    end

    SFrame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(i)
        end
    end)
    U.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    U.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end
    end)
end

