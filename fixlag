-- Hàm tạo Nút Bật/Tắt đẹp mắt
local function AddToggle(txt, fn)
    local B = Instance.new("TextButton", Scroll)
    B.Size, B.BackgroundColor3, B.Text = UDim2.new(0,220,0,35), Color3.fromRGB(180,40,40), txt..": TẮT"
    B.TextColor3, B.Font, B.TextSize = Color3.fromRGB(255,255,255), Enum.Font.GothamSemibold, 12
    Instance.new("UICorner", B).CornerRadius = UDim.new(0,6)
    local state = false
    B.MouseButton1Click:Connect(function()
        state = not state
        B.Text = txt..(state and ": BẬT" or ": TẮT")
        B.BackgroundColor3 = state and Color3.fromRGB(40,180,40) or Color3.fromRGB(180,40,40)
        fn(state)
    end)
end

------------------- TÍNH NĂNG ĐẶC BIỆT: FIX LAG & NÂNG FPS -------------------

-- 1. Siêu Fix Lag Tổng Hợp
AddToggle("⚡ Siêu Fix Lag (Max Smooth)", function(v)
    Settings.UltraLagFix = v
    if v then
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        L.FogEnd = 9e9
        L.GlobalShadows = false
        setFPS(60)
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
                v.CastShadow = false
            elseif v:IsA("MeshPart") then
                v.Material = Enum.Material.SmoothPlastic
                v.TextureID = ""
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            elseif v:IsA("Light") then
                v.Enabled = false
            end
        end
    end
end)

-- 2. Tắt Đổ Bóng & Ánh Sáng Nặng
AddToggle("🌑 Tắt Đổ Bóng & Hiệu Ứng Sáng", function(v)
    Settings.NoShadows = v
    L.GlobalShadows = not v
    if v then
        pcall(function() L.Technology = Enum.Technology.Compatibility end)
        for _, e in pairs(L:GetChildren()) do
            if e:IsA("PostEffect") then e.Enabled = false end
        end
    end
end)

-- 3. Nền Trơn (No Textures / No Decals)
AddToggle("🧱 Nền Trơn (Xóa Texture)", function(v)
    Settings.NoTextures = v
    if v then
        for _, e in pairs(workspace:GetDescendants()) do
            if e:IsA("BasePart") then
                e.Material = Enum.Material.SmoothPlastic
            elseif e:IsA("Decal") or e:IsA("Texture") then
                e:Destroy()
            end
        end
    end
end)

-- 4. Xóa Hiệu Ứng Chiêu Thức / Rác
AddToggle("✨ Xóa Particle / Sparks / Smoke", function(v)
    Settings.NoParticles = v
    if v then
        for _, e in pairs(workspace:GetDescendants()) do
            if e:IsA("ParticleEmitter") or e:IsA("Smoke") or e:IsA("Fire") or e:IsA("Sparkles") or e:IsA("Explosion") then
