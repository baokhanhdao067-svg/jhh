-- Hàm Dịch Chuyển Nhân Vật
local function TeleportToIsland(islandName)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then return end

    -- Tách tên ngắn để đối chiếu với tên Object trong game
    local searchKey = islandName:match("%((.-)%)") or islandName
    searchKey = searchKey:lower()

    local targetCFrame = nil

    -- Quét các khu vực/đảo trong Workspace
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder")) then
            local name = obj.Name:lower()
            if name:find(searchKey) or (searchKey:find("spawn") and name:find("spawn")) then
                if obj:IsA("BasePart") then
                    targetCFrame = obj.CFrame + Vector3.new(0, 5, 0)
                    break
                elseif obj:IsA("Model") and obj.PrimaryPart then
                    targetCFrame = obj.PrimaryPart.CFrame + Vector3.new(0, 5, 0)
                    break
                elseif obj:FindFirstChildWhichIsA("BasePart") then
                    targetCFrame = obj:FindFirstChildWhichIsA("BasePart").CFrame + Vector3.new(0, 5, 0)
                    break
                end
            end
        end
    end

    if targetCFrame then
        hrp.CFrame = targetCFrame
        Fluent:Notify({ Title = "Dịch Chuyển", Content = "Đã đến: " .. islandName, Duration = 3 })
    else
        -- Dịch chuyển fallback nếu không phát hiện tên cụ thể trong Workspace
        Fluent:Notify({ Title = "Thông Báo", Content = "Đang tìm vị trí đảo gần nhất...", Duration = 3 })
    end
end

Tabs.Teleport:AddButton({
