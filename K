-- 6. CHỨC NĂNG 2: SIÊU TỐC ĐỘ (ÉP TỐC DÙNG CFRAME CHỐNG LAG)
---------------------------------------------------------
local isSpeedBoost = false
local speedValue = 1.8 -- Tốc độ di chuyển tùy chỉnh mượt mà

speedBoostBtn.MouseButton1Click:Connect(function()
    isSpeedBoost = not isSpeedBoost
    speedBoostBtn.BackgroundColor3 = isSpeedBoost and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    speedBoostBtn.Text = "Siêu Tốc Độ: " .. (isSpeedBoost and "BẬT" or "TẮT")
end)

RunService.RenderStepped:Connect(function()
    if isSpeedBoost then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.MoveDirection.Magnitude > 0 then
                -- Đẩy nhân vật di chuyển theo hướng nhấn phím/joystick bằng CFrame
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * speedValue)
            end
        end
    end
end)

