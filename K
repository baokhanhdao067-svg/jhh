local function createToggle(name, yPos, cfgKey)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 250, 0, 32)
    btn.Position = UDim2.new(0.5, -125, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(160, 30, 30)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12

    btn.MouseButton1Click:Connect(function()
        Config[cfgKey] = not Config[cfgKey]
        btn.BackgroundColor3 = Config[cfgKey] and Color3.fromRGB(30, 160, 60) or Color3.fromRGB(160, 30, 30)
        btn.Text = name .. ": " .. (Config[cfgKey] and "ON" or "OFF")
    end)
end

