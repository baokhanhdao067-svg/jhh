-- Danh sách 7 Script theo yêu cầu
local scriptsData = {
    {num = "1", name = "Oroboros Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/joustingmatch/Ouroboros/main/loader.lua"))()'},
    {num = "2", name = "Lynx Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/Habibihidayat42/Lynxx/refs/heads/main/LynxHub.lua"))()'},
    {num = "3", name = "Speed Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/SpeedHubX/SpeedHubX-Roblox/main/FishingMaster.lua"))()'},
    {num = "4", name = "Chloe-X No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/MajestySkie/Chloe-X/main/Main/ChloeX"))()'},
    {num = "5", name = "Solvex Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/Solvexxxx/Scripts/refs/heads/main/SolvexGUI_FishIt.lua"))()'},
    {num = "6", name = "Redz Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/REDZ-HUB/FishingMaster/main/NoKey.lua"))()'},
    {num = "7", name = "Shadow Hub No Key", code = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/ShadowScript/FishingMaster/main/Main.lua"))()'}
}

-- Hàm tạo từng dòng Script + Nút Bật
for _, data in ipairs(scriptsData) do
    local ItemFrame = Instance.new("Frame")
    local ScriptLabel = Instance.new("TextLabel")
    local RunButton = Instance.new("TextButton")
    local ItemCorner = Instance.new("UICorner")

    ItemFrame.Name = "ItemFrame"
    ItemFrame.Parent = ScrollFrame
    ItemFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    ItemFrame.Size = UDim2.new(1, -10, 0, 42)

    ItemCorner.CornerRadius = UDim.new(0, 6)
    ItemCorner.Parent = ItemFrame

    ScriptLabel.Name = "ScriptLabel"
    ScriptLabel.Parent = ItemFrame
    ScriptLabel.BackgroundTransparency = 1.000
    ScriptLabel.Position = UDim2.new(0.03, 0, 0, 0)
    ScriptLabel.Size = UDim2.new(0.68, 0, 1, 0)
    ScriptLabel.Font = Enum.Font.GothamSemibold
    ScriptLabel.Text = data.num .. ". " .. data.name
    ScriptLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    ScriptLabel.TextSize = 13.00
    ScriptLabel.TextXAlignment = Enum.TextXAlignment.Left

    RunButton.Name = "RunButton"
    RunButton.Parent = ItemFrame
    RunButton.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
    RunButton.Position = UDim2.new(0.73, 0, 0.15, 0)
    RunButton.Size = UDim2.new(0.24, 0, 0.7, 0)
    RunButton.Font = Enum.Font.GothamBold
    RunButton.Text = "KÍCH HOẠT"
    RunButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    RunButton.TextSize = 11.00

    local BtnCorner = Instance.new("UICorner", RunButton)
    BtnCorner.CornerRadius = UDim.new(0, 5)

    -- Sự kiện nhấn nút kích hoạt Script
    RunButton.MouseButton1Click:Connect(function()
        RunButton.Text = "ĐANG CHẠY..."
        RunButton.BackgroundColor3 = Color3.fromRGB(200, 140, 30)
        
        task.spawn(function()
            local success, err = pcall(function()
                loadstring(data.code)()
            end)
            
            if success then
                RunButton.Text = "ĐÃ BẬT ✓"
                RunButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
            else
                RunButton.Text = "LỖI LINK!"
                RunButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                warn("Lỗi kích hoạt script: " .. tostring(err))
            end
            
            task.wait(2)
            RunButton.Text = "KÍCH HOẠT"
            RunButton.BackgroundColor3 = Color3.fromRGB(40, 160, 90)
        end)
    end)
end

-- Chức năng Nút Bật/Tắt (Toggle) Menu
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    if MainFrame.Visible then
        ToggleBtn.Text = "K HUB (ON)"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        ToggleBtn.Text = "K HUB (OFF)"
        ToggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)
