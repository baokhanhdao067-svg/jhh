-- 4. NHẬN DIỆN MANG TRỨNG & BẠN BÈ / CĂN CỨ
---------------------------------------------------------
local function isCarryingEggSpecial()
    local char = LocalPlayer.Character
    if not char then return false end
    
    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then
            return true
        end
    end
    
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Tool") then
            if part:FindFirstChildOfClass("Weld") or part:FindFirstChildOfClass("WeldConstraint") then
                if part.Name ~= "HumanoidRootPart" and not part.Name:find("Head") and not part.Name:find("Arm") and not part.Name:find("Leg") and not part.Name:find("Torso") then
                    return true
                end
            end
        end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then
        return true
    end

    return false
end

-- Tìm vị trí Căn cứ / Tổ trứng của người chơi (Map 1)
local function getMyBasePosition()
    local bases = Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Nests")
    if bases then
        for _, base in pairs(bases:GetChildren()) do
            local owner = base:FindFirstChild("Owner") or base:FindFirstChild("Player")
            if (owner and owner.Value == LocalPlayer) or base.Name:find(LocalPlayer.Name) then
                local eggDropZone = base:FindFirstChild("EggZone") or base:FindFirstChild("Deposit") or base:FindFirstChild("Spawn") or base:FindFirstChildOfClass("Part")
                if eggDropZone then
                    return eggDropZone.Position
                end
                return base:GetPivot().Position
            end
        end
    end
    
    -- Trường hợp dự phòng nếu game đặt SpawnLocation tại nhà
    if LocalPlayer.RespawnLocation then
        return LocalPlayer.RespawnLocation.Position
    end
    
    return Vector3.new(0, 10, 0) -- Vị trí trung tâm mặc định nếu không xác định được
end

