-- ==================== BỘ NHẬN DIỆN MỤC TIÊU ====================
local function isValidTarget(model)
    if not model or model == LocalPlayer.Character then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    local head = model:FindFirstChild("Head")
    
    if hum and hum.Health > 0 and rootPart and head then
        local plr = Players:GetPlayerFromCharacter(model)
        if plr then
            if plr == LocalPlayer then return false end
            if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then return false end
            return true
        end
        return true -- Nhận diện tất cả Con rối, NPC, Target
    end
    return false
end

local function equipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if char and backpack then
        if not char:FindFirstChildOfClass("Tool") then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    item.Parent = char
                    break
                end
            end
        end
    end
end

local function createToggleButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = ContentScroll
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text .. ": TẮT"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 13
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = text .. ": BẬT"
            btn.TextColor3 = Color3.fromRGB(0, 255, 128)
            btn.BackgroundColor3 = Color3.fromRGB(35, 55, 40)
        else
            btn.Text = text .. ": TẮT"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        end
        pcall(callback, state)
    end)
    return btn
end

