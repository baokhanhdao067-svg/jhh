-- FUNCTION: KIỂM TRA MANG TRỨNG & QUÉT TRỨNG
---------------------------------------------------------
local function isCarryingEgg()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, obj in pairs(char:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("egg") or n:find("trung") then
            return true
        end
    end

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Tool") then
            if part:FindFirstChildOfClass("Weld") or part:FindFirstChildOfClass("WeldConstraint") then
                if part.Name ~= "HumanoidRootPart" and not part.Name:find("Head") and not part.Name:find("Arm") and not part.Name:find("Leg") and not part.Name:find("Torso") then
                    return true
                end
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and #backpack:GetChildren() > 0 then
        return true
    end

    return false
end

local function getNearestEgg()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local closestEgg = nil
    local minDistance = 500

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            local name = v.Name:lower()
            if (name:find("egg") or name:find("trung")) and not v:IsDescendantOf(char) then
                local pos = v:IsA("Model") and (v.PrimaryPart and v.PrimaryPart.Position or v:GetAttribute("Position")) or v.Position
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        closestEgg = {Object = v, Position = pos}
                    end
                end
            end
        end
    end
    return closestEgg
end

---------------------------------------------------------
-- ADVANCED GROUND GLIDE ENGINE (SMOOTH & NO-DELAY)
---------------------------------------------------------
local isGLiding = false

local function smartGlideTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    isGLiding = true
    if hum then hum.PlatformStand = true end

    while isGLiding and char and hrp do
        local currentPos = hrp.Position
        local targetGround = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
        local dir = (targetGround - currentPos)
        local dist = dir.Magnitude

        if dist < 3 then break end

        -- Lướt sát mặt đất chia theo DeltaTime mượt 100%
        local step = math.min(dist, Config.Speed * task.wait())
        hrp.CFrame = CFrame.new(currentPos + (dir.Unit * step))
    end

    if hum then hum.PlatformStand = false end
    isGLiding = false
end

