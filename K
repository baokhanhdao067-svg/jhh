-- 7. CHỨC NĂNG 3: CHỐNG QUÁI ĐÁNH (ANTI-HIT)
---------------------------------------------------------
local isAntiHit = false

antiHitBtn.MouseButton1Click:Connect(function()
    isAntiHit = not isAntiHit
    antiHitBtn.BackgroundColor3 = isAntiHit and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    antiHitBtn.Text = "Chống Quái Đánh: " .. (isAntiHit and "BẬT" or "TẮT")
end)

RunService.Stepped:Connect(function()
    if isAntiHit then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            end
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)
